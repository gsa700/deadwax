<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Deadwax.Drive\Deadwax.Drive.csproj" />
    <ProjectReference Include="..\Deadwax.Metadata\Deadwax.Metadata.csproj" />
    <ProjectReference Include="..\Deadwax.Verify\Deadwax.Verify.csproj" />
    <ProjectReference Include="..\Deadwax.Output\Deadwax.Output.csproj" />
    <ProjectReference Include="..\Deadwax.Core\Deadwax.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>deadwax</AssemblyName>
    <RootNamespace>Deadwax.Cli</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No DOTNET_STARTUP_HOOKS: it runs managed code from any assembly named
         in the environment inside this process, signed or not, hardened
         runtime or not (security review 2026-10-24, M1). -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>
</Project>
