<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The executable is the product's name, as everywhere in the family
         (AlbumWall, ShackPower): Deadwax, not Deadwax.App. -->
    <AssemblyName>Deadwax</AssemblyName>
    <RootNamespace>Deadwax.App</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Native AOT (the road to 0.8): warn at every build about code a
         trimmed or compiled build cannot run. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- WindowsShell.cs: source-generated COM ([GeneratedComInterface]) and its
         buffers, the kind Native AOT can run. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No DOTNET_STARTUP_HOOKS: it runs managed code from any assembly named
         in the environment inside this process, signed or not, hardened
         runtime or not (security review 2026-10-24, M1). -->
    <StartupHookSupport>false</StartupHookSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- The same Avalonia as AlbumWall, so the two look and behave alike and one
       upgrade covers both. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deadwax.Core\Deadwax.Core.csproj" />
  </ItemGroup>

  <!-- The icon: Assets/icon.svg is the source; icon-256.png is rendered from it
       (rsvg-convert -w 256 -h 256) and committed, for the window's own icon
       and the app menu. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon-256.png" />
  </ItemGroup>

  <!-- The installer's icons (2026-10-18), rendered from Assets/icon.svg by
       tools/make-icon.cs and committed. app.ico is compiled into the exe: on
       Windows that is the only icon Explorer, the taskbar, the Start Menu
       shortcut and the Installed-apps entry ever see. app-icon.png is embedded
       plainly for the Linux installer, which writes it into the hicolor theme;
       the install switch runs before Avalonia, so it is read as a manifest
       resource. -->
  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\app-icon.png" LogicalName="app-icon.png" />
  </ItemGroup>
</Project>
