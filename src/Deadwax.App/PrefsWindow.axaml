<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Deadwax.App"
        x:Class="Deadwax.App.PrefsWindow"
        x:DataType="app:MainViewModel"
        Title="Deadwax — Preferences"
        Width="580" Height="620" CanResize="False"
        Background="{StaticResource Ground}"
        ShowInTaskbar="False">

    <!-- AlbumWall's Preferences format, so the two read as companions: a proper
         window with the system's own title bar, 580 wide, fixed size, one
         instance, no Close button because the title bar has one, settings
         written straight through, section headings at 14 semibold with a dim
         13 explanation under each, panel buttons, a path shown in a box.
         The Disc screen keeps only what is about this disc; everything about
         the machine or the program lives here (his call, 2026-10-05). About is
         the last tab; new tabs go before it.

         WORDING: for someone on a clean install who has never heard of whipper
         or of his library tools. Nothing here names a program the reader may
         not have, except where it only appears when that program is present. -->
    <TabControl x:Name="Tabs" Margin="12">
        <TabItem Header="Library">
            <StackPanel Spacing="12">
                <TextBlock Text="Where the music goes" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Text="Each disc becomes a folder, Artist/YEAR - Album/, with the FLAC files, the cover and the rip log inside. If an artist is already in the library, their name is spelled the way it is there."/>
                <Border CornerRadius="4" Padding="13,11" Background="{StaticResource Bar}">
                    <TextBlock x:Name="LibraryPath" FontSize="13" Classes="mono" TextWrapping="Wrap"/>
                </Border>
                <TextBlock x:Name="LibraryNote" Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Button Classes="panel" Content="Choose folder…" Click="OnChooseLibrary"/>
                    <Button Classes="panel" Content="Use my Music folder" Click="OnUseDefaultLibrary"/>
                </StackPanel>

                <StackPanel Spacing="12">
                    <Border Height="1" Background="{StaticResource Rule}" Margin="0,6,0,0"/>
                    <TextBlock Text="After a rip" FontSize="14" FontWeight="SemiBold"/>
                    <CheckBox x:Name="PostRipBox" FontSize="13" Content="Finish the new album for the library" Click="OnPostRipToggled"/>
                    <TextBlock Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                               Text="A disc from a set, when you chose to file it as the album it originally was, is retagged with that album's own title, year and front cover, and its folder renamed. Then the back cover is fetched from the Cover Art Archive as back.jpg: this pressing's when it has one, otherwise another edition's of the same album. Where music-audit is installed, it then checks the whole library. Runs only after a rip where every track read the same twice."/>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="Drive">
            <StackPanel Spacing="12">
                <TextBlock Text="This drive" FontSize="14" FontWeight="SemiBold"/>
                <Border CornerRadius="4" Padding="13,11" Background="{StaticResource Bar}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DriveNameText" FontSize="13" Classes="mono"/>
                        <TextBlock x:Name="DeviceText" FontSize="12" Classes="mono dim"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Read offset" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <TextBlock Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Text="Every drive hands back audio a few samples early or late, always by the same amount. Correcting it makes your rips identical to everyone else's, which is what lets them be verified. Deadwax measures it once, from a well-known commercial CD (sometimes it needs two), and remembers it for this drive."/>
                <Border CornerRadius="4" Padding="13,11" Background="{StaticResource Bar}">
                    <TextBlock x:Name="OffsetValueText" FontSize="13" Classes="mono"/>
                </Border>
                <Button Classes="panel" HorizontalAlignment="Left" Content="Measure from the disc in the drive…"
                        Click="OnMeasure" IsEnabled="{Binding !MeasuringOffset}"/>
                <TextBlock Text="{Binding OffsetText}" Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>

                <Border Height="1" Background="{StaticResource Rule}" Margin="0,6,0,0"/>
                <TextBlock Text="Speed" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Text="A disc that is slightly out of balance vibrates at full speed and can stop the drive answering. Capping the speed cures it; try 4x first, then lower. Reading takes longer, and the cap is noted in the rip log. The setting stays until you change it."/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding DriveSpeed}" MinWidth="150" FontSize="13"/>
                    <CheckBox IsChecked="{Binding EjectAfterRip}" FontSize="13" Content="Open the tray when a rip is done" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="About">
            <StackPanel Spacing="12">
                <!-- The icon beside the name, as a program's About page has. -->
                <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,4,0,6">
                    <Image Source="/Assets/icon-256.png" Width="96" Height="96" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Deadwax" FontSize="26" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Classes="dim" FontSize="14"/>
                        <TextBlock Text="The companion to AlbumWall" Classes="dim" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Text="Rips CDs into a FLAC library you own. Every track is read twice until two readings agree, then checked against AccurateRip, the database of what thousands of other drives read from the same disc. Tags come from MusicBrainz. Free software, GPLv3."/>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Button x:Name="UpdateButton" Classes="panel" Content="Check for updates" Click="OnCheckUpdates"/>
                    <Button Classes="panel" Content="Deadwax on GitHub" Click="OnOpenRepo"/>
                    <Button Classes="panel" Content="AlbumWall" Click="OnOpenAlbumWall"/>
                </StackPanel>
                <!-- As AlbumWall's About tab: one button that checks, then reads
                     "Update to X and restart" when there is something to install,
                     and a bar while it downloads. The check at launch only ever
                     lights the dot on the gear; nothing is fetched until this. -->
                <TextBlock x:Name="UpdateText" Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                <Border x:Name="UpdateBar" Height="4" CornerRadius="2" IsVisible="False" Background="{StaticResource Bar}">
                    <Border x:Name="UpdateFill" Height="4" CornerRadius="2" Width="0" HorizontalAlignment="Left" Background="{StaticResource Text}"/>
                </Border>
                <CheckBox x:Name="AutoCheckBox" FontSize="13" Content="Look for a newer release when Deadwax opens" Click="OnAutoCheckToggled"/>
                <TextBlock Classes="dim" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Text="A newer release is offered in the title bar; nothing is downloaded until you ask, and the download is checked against the release's published checksum before it is installed."/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
