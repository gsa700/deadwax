<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Deadwax.Drive\Deadwax.Drive.csproj" />
    <!-- Spindle.Core, the helpers the apps share (the submodule at spindle/):
         WebLimits, AppVersion, VersionOrder, ReleaseFeed, LogFile, Diagnostics.
         Every project above this one reaches it through here. -->
    <ProjectReference Include="..\..\spindle\src\Spindle.Core\Spindle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The version Avalonia ships, so the app carries one copy; the native
         library comes with the app (and the tests) by SkiaSharp.NativeAssets.Linux. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native AOT (the road to 0.8): warn at every build about code a
         trimmed or compiled build cannot run. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Spindle" />
  </ItemGroup>

</Project>
