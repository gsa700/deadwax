# Normalise line endings in the repo. Project templates emit
# CRLF for some files; without this a Windows contributor's first commit
# would look like a whole-file rewrite.
* text=auto eol=lf
*.png binary
*.jpg binary
*.webp binary

*.bin binary

# Golden files are real rip output, kept byte for byte (one has a stray CR
# inside a CD-Text string on purpose).
tests/Deadwax.Tests/Golden/** -text
