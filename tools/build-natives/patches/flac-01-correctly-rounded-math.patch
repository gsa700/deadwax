diff -ruN a/src/libFLAC/crmath_roundeven.c b/src/libFLAC/crmath_roundeven.c
--- a/src/libFLAC/crmath_roundeven.c
+++ b/src/libFLAC/crmath_roundeven.c
@@ -0,0 +1,8 @@
+/* Deadwax: CORE-MATH's cosf calls roundeven, which glibc and Apple's libm
+ * have and mingw-w64 does not. Exact either way: nearbyint in the default
+ * rounding mode (to nearest, ties to even; libFLAC never changes it). */
+#ifdef _WIN32
+#include <math.h>
+double roundeven(double x);
+double roundeven(double x) { return nearbyint(x); }
+#endif
