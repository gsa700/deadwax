diff -ruN a/src/libFLAC/include/private/crmath.h b/src/libFLAC/include/private/crmath.h
--- a/src/libFLAC/include/private/crmath.h
+++ b/src/libFLAC/include/private/crmath.h
@@ -0,0 +1,20 @@
+/* Deadwax: cosf and log through CORE-MATH's correctly rounded versions
+ * (crmath_cosf.c, crmath_log.c), not the platform's maths library.
+ *
+ * The encoder picks its apodization window with cosf and estimates each
+ * frame's best predictor with log. glibc, mingw-w64 and Apple's libm can
+ * differ in the last bit, which now and then tips a choice and changes the
+ * bytes of a frame (never the audio). A correctly rounded result is the same
+ * everywhere, so the same audio encodes to the same file on every platform.
+ * Include after <math.h>.
+ */
+#ifndef FLAC__PRIVATE__CRMATH_H
+#define FLAC__PRIVATE__CRMATH_H
+#include <math.h>
+float cr_cosf(float x);
+double cr_log(double x);
+#undef cosf
+#undef log
+#define cosf cr_cosf
+#define log cr_log
+#endif
